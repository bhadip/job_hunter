# --- Google Sheets ---
GOOGLE_APPLICATION_CREDENTIALS=/app/data/credentials.json
GOOGLE_SHEET_ID=1yspWca6Fqp_YuSB9ZkPPtyxO3RZSCCNNamVHTy7kbSE
GOOGLE_SHEET_NAME=Job_Applications_v3

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=sk-...
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL_SCORE=gpt-4o-mini
OPENAI_MODEL_GENERATE=gpt-4o
DEFAULT_JD_ASSESSMENT_PROMPT=/path/to/JD_Assessment_Prompt_Template.md
# Optional: ask the API for guaranteed-JSON output on scoring calls.
# If the endpoint rejects response_format, the call is retried without it.
OPENAI_JSON_MODE=false

# --- Telegram ---
TELEGRAM_BOT=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# --- Cloudflare Access (Google IdP) ---
# Leave CF_TEAM_DOMAIN / CF_ACCESS_AUD empty for local dev mode (no auth,
# single user). CF_APP_URL is optional: it adds a "continue" link on the
# page shown to browsers that hit the app directly (bypassing Access).
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud-tag
CF_APP_URL=https://jobhunt.yourdomain.com

# --- App ---
PORT=8503
SCORE_THRESHOLD=65
APP_TIMEZONE=Asia/Singapore
DATA_DIR=/app/data
OUTPUT_DIR=/app/output
