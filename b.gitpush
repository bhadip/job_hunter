#!/usr/bin/env bash                                                                                                                                                                                                                   
# Usage: gitpush "your commit message"                                                                                                                                                                                                
set -e                                                                                                                                                                                                                                
                                                                                                                                                                                                                                      
if [ -z "$1" ]; then                                                                                                                                                                                                                  
  echo "Usage: gitpush \"commit message\""                                                                                                                                                                                            
  exit 1                                                                                                                                                                                                                              
fi                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                      
git add -A                                                                                                                                                                                                                            
                                                                                                                                                                                                                                      
if git diff --cached --quiet; then                                                                                                                                                                                                    
  echo "Nothing to commit."                                                                                                                                                                                                           
  exit 0                                                                                                                                                                                                                              
fi                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                      
git commit -m "$1"                                                                                                                                                                                                                    
git push
